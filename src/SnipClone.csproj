<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 22621 SDK projection exposes GraphicsCaptureSession.IsBorderRequired; the app still runs on 19041+. -->
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SnipClone</AssemblyName>
    <RootNamespace>SnipClone</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Product>SnipClone</Product>
    <Description>Clean-room screen snipping tool. Built with Claude Code after studying Snipping Tool with the REA MCP.</Description>
    <!-- WPF Fluent theme (ThemeMode) is marked experimental in .NET 9. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\assets\icon.ico" Link="icon.ico" />
  </ItemGroup>

</Project>
